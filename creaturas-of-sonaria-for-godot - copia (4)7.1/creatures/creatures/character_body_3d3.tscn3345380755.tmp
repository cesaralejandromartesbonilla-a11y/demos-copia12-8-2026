script/source = "extends Area3D
class_name CropPlotGrid

enum State { EMPTY, GROWING, READY, DIRTY, PEST_INFESTED, NEEDS_CLEARING }

@export var cell_world_size: float = 1.0
@export var plot_type: SeedData.TerrainRequired = SeedData.TerrainRequired.NORMAL_PLOT
@export var grid_columns: int = 3 # Cambiado a 3 por defecto para tu nuevo estándar
@export var grid_rows: int = 3
@export var signals: bool = false

var current_state: State = State.EMPTY
var growth_progress: float = 0.0
var planted_seed_data: SeedData = null
var grid_size: Vector2i = Vector2i(3, 3)
var occupancy_grid: Array = [] 
var active_crops: Array[Dictionary] = [] 
var grid_slots: Dictionary = {}
var current_water: float = 0.0
var current_organic_matter: float = 0.0
var is_fertilized: bool = false
var is_submerged: bool = false
var custom_material: StandardMaterial3D

@onready var item_base_scene = preload(\"res://items/pickable_item.tscn\")
@onready var plot_mesh = $plot_mesh
@onready var interaction = $CropInteraction

func _ready() -> void:
	_initialize_grid()
	area_entered.connect(_on_area_entered)
	area_exited.connect(_on_area_exited)
	_scan_environment()
	
	if plot_mesh:
		custom_material = StandardMaterial3D.new()
		plot_mesh.material_override = custom_material
		
	add_to_group(\"crop_plot\")
	add_to_group(\"estructuras\")

func _initialize_grid() -> void:
	# Sincronización automática basada en tus nuevos tamaños preestablecidos
	if plot_type == SeedData.TerrainRequired.NORMAL_PLOT:
		grid_columns = 3
		grid_rows = 3
	elif plot_type == SeedData.TerrainRequired.LARGE_PLOT:
		grid_columns = 4 # O el tamaño máximo que decidas para parcelas grandes
		grid_rows = 4
		
	grid_size = Vector2i(grid_columns, grid_rows)
	occupancy_grid.clear()
	grid_slots.clear()
	
	for x in range(grid_size.x):
		var column = []
		for y in range(grid_size.y):
			column.append(false)
		occupancy_grid.append(column)

func can_fit(crop_size: Vector2i, start_cell: Vector2i, seed_data: SeedData = null) -> bool:
	if seed_data and seed_data.required_terrain != plot_type:
		return false
		
	if crop_size == grid_size and start_cell == Vector2i(0, 0):
		return grid_slots.is_empty()
		
	# Recorremos el área cuadrada que ocupará el cultivo de forma limpia
	for x in range(crop_size.x):
		for y in range(crop_size.y):
			var target_cell = start_cell + Vector2i(x, y)
			
			# Límites físicos de la parcela
			if target_cell.x < 0 or target_cell.x >= grid_columns or target_cell.y < 0 or target_cell.y >= grid_rows:
				return false
				
			# Verificación de ocupación
			if grid_slots.has(target_cell) and grid_slots[target_cell] != null:
				return false
				
	return true

func register_new_crop(seed_data: SeedData, origin_cell: Vector2i) -> void:
	var crop_entry = {
		\"seed_data\": seed_data,
		\"origin_cell\": origin_cell,
		\"growth_progress\": 0.0,
		\"current_state\": State.GROWING
	}
	
	# Llenamos el bloque usando el tamaño del cultivo (1x1, 2x2, 3x3)
	for x in range(seed_data.crop_size.x):
		for y in range(seed_data.crop_size.y):
			var target_cell = origin_cell + Vector2i(x, y)
			grid_slots[target_cell] = crop_entry
			occupancy_grid[target_cell.x][target_cell.y] = true
	
	active_crops.append(crop_entry)
	planted_seed_data = seed_data
	current_state = State.GROWING
	
	var visuals = get_node_or_null(\"CropVisuals\")
	if visuals and visuals.has_method(\"spawn_crop_visual\"):
		visuals.spawn_crop_visual(seed_data, origin_cell)
		
	if signals: print(\"[Grid] Planta añadida. Tamaño: \", seed_data.crop_size, \" en origen: \", origin_cell)

func plant_crop_in_grid(seed_data: SeedData, origin: Vector2i) -> void:
	register_new_crop(seed_data, origin)

func interact(player: Node3D, cell: Vector2i = Vector2i(-1, -1)) -> void:
	if interaction: interaction.handle_interaction(player, cell)

func _scan_environment() -> void:
	var overlapping = get_overlapping_areas()
	var found_water = false
	for area in overlapping:
		if _is_area_water(area):
			found_water = true
			break
	_update_submerged_state(found_water)

func _on_area_entered(area: Area3D) -> void:
	if _is_area_water(area): _update_submerged_state(true)

func _on_area_exited(area: Area3D) -> void:
	if _is_area_water(area): _scan_environment()

func _is_area_water(area: Area3D) -> bool:
	return area.is_in_group(\"agua\") or area.is_in_group(\"water\")

func _update_submerged_state(submerged: bool) -> void:
	is_submerged = submerged
	if is_submerged:
		if custom_material: custom_material.albedo_color = Color(0.3, 0.2, 0.15) 
	else:
		if custom_material: custom_material.albedo_color = Color(0.6, 0.4, 0.2)

func process_grid_growth(tick_energy: float) -> void:
	if active_crops.is_empty(): return
	var visuals = get_node_or_null(\"CropVisuals\")
	
	for i in range(active_crops.size() - 1, -1, -1):
		var crop = active_crops[i]
		if crop[\"current_state\"] == State.READY or crop[\"current_state\"] == State.NEEDS_CLEARING:
			continue
			
		var s_data = crop[\"seed_data\"] as SeedData
		crop[\"growth_progress\"] += tick_energy
		var ratio = clampf(crop[\"growth_progress\"] / s_data.grow_time_ticks, 0.0, 1.0)
		
		if crop[\"growth_progress\"] >= s_data.grow_time_ticks:
			crop[\"current_state\"] = State.READY
			
		if visuals and visuals.has_method(\"update_crop_visual\"):
			visuals.update_crop_visual(crop[\"origin_cell\"], s_data, ratio, crop[\"current_state\"])

func cell_to_local_3d(cell: Vector2i) -> Vector3:
	var start_x = - (grid_columns * cell_world_size) / 2.0
	var start_z = - (grid_rows * cell_world_size) / 2.0
	var local_x = start_x + (cell.x + 0.5) * cell_world_size
	var local_z = start_z + (cell.y + 0.5) * cell_world_size
	return Vector3(local_x, 0.0, local_z)

func global_to_cell(global_pos: Vector3) -> Vector2i:
	var local_pos = to_local(global_pos)
	var start_x = - (grid_columns * cell_world_size) / 2.0
	var start_z = - (grid_rows * cell_world_size) / 2.0
	var cell_x = floor((local_pos.x - start_x) / cell_world_size)
	var cell_z = floor((local_pos.z - start_z) / cell_world_size)
	return Vector2i(clampi(cell_x, 0, grid_columns - 1), clampi(cell_z, 0, grid_rows - 1))

func save_data() -> Dictionary:
	var saved_crops_array: Array = []
	for crop in active_crops:
		var crop_data = {
			\"seed_path\": crop[\"seed_data\"].resource_path,
			\"origin_x\": crop[\"origin_cell\"].x,
			\"origin_y\": crop[\"origin_cell\"].y,
			\"growth_progress\": crop[\"growth_progress\"],
			\"current_state\": crop[\"current_state\"]
		}
		saved_crops_array.append(crop_data)

	return {
		\"filename\" : get_scene_file_path(),
		\"parent\" : str(get_parent().get_path()) if get_parent() else \"\",
		\"pos_x\" : global_position.x, \"pos_y\" : global_position.y, \"pos_z\" : global_position.z,
		\"rot_x\" : global_rotation.x, \"rot_y\" : global_rotation.y, \"rot_z\" : global_rotation.z,
		\"current_state\" : current_state, \"current_compost\" : is_fertilized, \"is_watered\": is_submerged,
		\"active_crops_data\": saved_crops_array
	}

func load_data(saved_dict: Dictionary) -> void:
	is_fertilized = saved_dict.get(\"current_compost\", false)
	is_submerged = saved_dict.get(\"is_watered\", false)
	current_state = saved_dict.get(\"current_state\", State.EMPTY)
	_update_submerged_state(is_submerged)
	
	_initialize_grid()
	active_crops.clear()
	if not saved_dict.has(\"active_crops_data\"): return
	
	var visuals = get_node_or_null(\"CropVisuals\")
	for crop_data in saved_dict[\"active_crops_data\"]:
		var seed_path = crop_data[\"seed_path\"]
		if ResourceLoader.exists(seed_path):
			var s_data = load(seed_path) as SeedData
			var origin = Vector2i(crop_data[\"origin_x\"], crop_data[\"origin_y\"])
			
			var restored_crop = {
				\"seed_data\": s_data, \"origin_cell\": origin,
				\"growth_progress\": crop_data[\"growth_progress\"], \"current_state\": crop_data[\"current_state\"]
			}
			active_crops.append(restored_crop)
			
			# Re-bloquear las celdas usando el tamaño cargado
			for x in range(s_data.crop_size.x):
				for y in range(s_data.crop_size.y):
					var target_cell = origin + Vector2i(x, y)
					grid_slots[target_cell] = restored_crop
					occupancy_grid[target_cell.x][target_cell.y] = true
			
			if visuals and visuals.has_method(\"spawn_crop_visual\"):
				visuals.spawn_crop_visual(s_data, origin)
				var ratio = clampf(restored_crop[\"growth_progress\"] / s_data.grow_time_ticks, 0.0, 1.0)
				if visuals.has_method(\"update_crop_visual\"):
					visuals.update_crop_visual(origin, s_data, ratio, restored_crop[\"current_state\"])
				
	if not active_crops.is_empty(): planted_seed_data = active_crops[0][\"seed_data\"]
"

