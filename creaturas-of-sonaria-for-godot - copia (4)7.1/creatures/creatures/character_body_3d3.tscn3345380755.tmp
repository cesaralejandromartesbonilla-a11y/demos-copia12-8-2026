[sub_resource type="GDScript" id="GDScript_fegob"]
script/source = "extends Node
class_name CropInteraction

@onready var plot: CropPlotGrid = get_parent()

func handle_interaction(player: Node3D, cell: Vector2i = Vector2i(-1, -1)) -> void:
	var hands = player.get_node_or_null(\"HandsInventory\")
	if not hands: return
	var held_item = hands.item_in_right
	
	if held_item and held_item.data and held_item.data.seed_data:
		_try_plant_seed_in_slot(held_item, hands, cell)
	else:
		_handle_normal_interaction(player)

func _try_plant_seed_in_slot(seed_item: PickableItem, hands: Node, target_cell: Vector2i) -> void:
	var s_data = seed_item.data.seed_data
		
	if s_data.requires_submerged and not plot.is_submerged:
		return

func _handle_normal_interaction(player: Node3D) -> void:
	var hit_point = _get_camera_raycast_hit()
	if hit_point == Vector3.INF: return
	
	var clicked_cell = plot.global_to_cell(hit_point)
	var target_crop_index = _find_crop_at_cell(clicked_cell)
	
	if target_crop_index == -1: return
		
	var crop = plot.active_crops[target_crop_index]
	if crop[\"current_state\"] == plot.State.READY:
		_harvest_crop_at_index(target_crop_index, player)

func _get_camera_raycast_hit() -> Vector3:
	var camera = get_viewport().get_camera_3d()
	var mouse_pos = get_viewport().get_mouse_position()
	var ray_origin = camera.project_ray_origin(mouse_pos)
	var ray_end = ray_origin + camera.project_ray_normal(mouse_pos) * 50.0
	
	var space_state = plot.get_viewport().world_3d.direct_space_state
	var query = PhysicsRayQueryParameters3D.create(ray_origin, ray_end)
	query.collide_with_areas = true
	query.collide_with_bodies = false
	
	var result = space_state.intersect_ray(query)
	if result and result.collider == plot:
		return result.position
	return Vector3.INF

# COMPROBACIÓN EXTREMADAMENTE OPTIMIZADA POR LÍMITES DE CAJA
func _find_crop_at_cell(cell: Vector2i) -> int:
	for i in range(plot.active_crops.size()):
		var crop = plot.active_crops[i]
		var origin = crop[\"origin_cell\"] as Vector2i
		var size = crop[\"seed_data\"].crop_size as Vector2i
		
		# Si la celda cliqueada cae dentro del rectángulo (origen -> origen + tamaño), es la planta correcta
		if cell.x >= origin.x and cell.x < (origin.x + size.x) and cell.y >= origin.y and cell.y < (origin.y + size.y):
			return i
	return -1

func _harvest_crop_at_index(index: int, player: Node3D) -> void:
	var crop = plot.active_crops[index]
	var s_data = crop[\"seed_data\"] as SeedData
	var origin = crop[\"origin_cell\"]
	
	if s_data.result_item_data: _spawn_reward_item(s_data.result_item_data, s_data.drop_amount)
	if s_data.secondary_result_data: _spawn_reward_item(s_data.secondary_result_data, 1)
		
	var visuals = plot.get_node_or_null(\"CropVisuals\")
	if visuals and visuals.has_method(\"remove_crop_visual\"):
		visuals.remove_crop_visual(origin)
		
	# Limpiamos las celdas recorriendo el rango de su tamaño cuadrado
	for x in range(s_data.crop_size.x):
		for y in range(s_data.crop_size.y):
			var target_cell = origin + Vector2i(x, y)
			plot.occupancy_grid[target_cell.x][target_cell.y] = false
			if plot.grid_slots.has(target_cell):
				plot.grid_slots.erase(target_cell)
		
	plot.active_crops.remove_at(index)
	if plot.active_crops.is_empty():
		plot.planted_seed_data = null
		plot.current_state = plot.State.EMPTY

func _spawn_reward_item(item_data: ItemData, amount: int) -> void:
	if plot.item_base_scene == null: return
	for n in range(amount):
		var item_instance = plot.item_base_scene.instantiate()
		item_instance.data = item_data
		plot.get_tree().current_scene.add_child(item_instance)
		var random_offset = Vector3(randf_range(-0.2, 0.2), 0.5, randf_range(-0.2, 0.2))
		item_instance.global_position = plot.global_position + random_offset
"

