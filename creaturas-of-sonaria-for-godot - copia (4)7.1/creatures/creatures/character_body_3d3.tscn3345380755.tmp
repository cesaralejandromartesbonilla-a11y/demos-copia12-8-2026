[sub_resource type="GDScript" id="GDScript_sat7o"]
script/source = "extends Node3D
class_name CropVisuals

@onready var plot = get_parent()
var spawned_nodes: Dictionary = {}

func spawn_crop_visual(seed_data: SeedData, origin_cell: Vector2i) -> void:
	if seed_data == null or seed_data.visual_data == null: return
	var v_data = seed_data.visual_data
	var mesh_instance = MeshInstance3D.new()
	
	if v_data.style == CropVisualData.VisualStyle.COLOR_SHIFT:
		mesh_instance.mesh = v_data.single_mesh
		var unique_mat = StandardMaterial3D.new()
		unique_mat.albedo_color = v_data.start_color
		mesh_instance.material_override = unique_mat
	else:
		mesh_instance.mesh = v_data.sprout_mesh
		
	add_child(mesh_instance)
	
	# --- CENTRADO EN CAJA MATEMÁTICO DIRECTO ---
	# Obtiene la posición 3D de la celda origen y la celda final del tamaño del cultivo
	var start_pos = plot.cell_to_local_3d(origin_cell)
	var end_pos = plot.cell_to_local_3d(origin_cell + seed_data.crop_size - Vector2i(1, 1))
	
	# El centro geométrico perfecto es el punto medio entre ambas esquinas
	mesh_instance.position = (start_pos + end_pos) / 2.0
	
	spawned_nodes[origin_cell] = mesh_instance

func update_crop_visual(origin_cell: Vector2i, seed_data: SeedData, ratio: float, current_state: int) -> void:
	if not spawned_nodes.has(origin_cell): return
	var mesh_instance = spawned_nodes[origin_cell]
	var v_data = seed_data.visual_data
	
	if v_data.style == CropVisualData.VisualStyle.COLOR_SHIFT:
		var mat = mesh_instance.material_override as StandardMaterial3D
		if mat: mat.albedo_color = v_data.start_color.lerp(v_data.ready_color, ratio)
	else:
		var target_mesh: Mesh = v_data.sprout_mesh
		if current_state == plot.State.READY:
			target_mesh = v_data.ready_mesh
		elif ratio >= 0.4:
			target_mesh = v_data.growing_mesh
			
		if mesh_instance.mesh != target_mesh:
			mesh_instance.mesh = target_mesh

func remove_crop_visual(origin_cell: Vector2i) -> void:
	if spawned_nodes.has(origin_cell):
		spawned_nodes[origin_cell].queue_free()
		spawned_nodes.erase(origin_cell)
"

